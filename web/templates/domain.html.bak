  <div class="bnt">
    <div class="topbnt_left fl">
      <ul>
        <li class="unactive"><a href="0analysis.html">流量测量</a></li>
        <li class="active"><a href="0domain.html">域统计</a></li>
        <li class="unactive"><a href="0record.html">异常检测</a></li>
      </ul>
    </div>
    <h1 class="tith1 fl">域统计</h1>
    <div class="topbnt_right fr">
      <ul>
        <li>
          <a href="https://172.16.233.214:7777/boss/release/100007">返回</a>
        </li>
      </ul>
    </div>
  </div>





  <div class="visual">
    <div class="visual_left">
      <div class="visual_box">
        <div class="listbox fl">
          <div class="t_line_box">
            <i class="t_l_line"></i>
            <i class="l_t_line"></i>
          </div>
          <div class="t_line_box">
            <i class="t_r_line"></i>
            <i class="r_t_line"></i>
          </div>
          <div class="t_line_box">
            <i class="l_b_line"></i>
            <i class="b_l_line"></i>
          </div>
          <div class="t_line_box">
            <i class="r_b_line"></i>
            <i class="b_r_line"></i>
          </div>
          <div class="main_title">全局跨域分析</div>
          <div class="main_table t_btn8">
            <table>
              <thead>
                <tr>
                  <!-- Rank,scrIP,Location_src,dstIP,Location_dst -->
                  <th style="width: 14%">序号</th>
                  <th style="width: 14%">源IP</th>
                  <th style="width: 14%">地区</th>
                  <th style="width: 14%">目的IP</th>
                  <th style="width: 20%">地区</th>
                  <!-- <th style="width: 10%">包大小(B)</th> -->
                </tr>
              </thead>
              <tbody id="table5"></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="visual_box">
        <div class="listbox fl">
          <div class="t_line_box">
            <i class="t_l_line"></i>
            <i class="l_t_line"></i>
          </div>
          <div class="t_line_box">
            <i class="t_r_line"></i>
            <i class="r_t_line"></i>
          </div>
          <div class="t_line_box">
            <i class="l_b_line"></i>
            <i class="b_l_line"></i>
          </div>
          <div class="t_line_box">
            <i class="r_b_line"></i>
            <i class="b_r_line"></i>
          </div>
          <div class="main_title">IP网段情况统计</div>
          <div class="main_table t_btn8">
            <table>
              <thead>
                <tr>
                  <th style="width: 14%">序号</th>
                  <th style="width: 14%">IP网段</th>
                  <th style="width: 14%">次数</th>
                </tr>
              </thead>
              <tbody id="table6"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>



    <div class="visual_con" style="height: 97%">
      <div style="height: 5%; text-align: center">
        <div style="height: 5%; text-align: center">
          <div style="
                border-color: #4788fb;
                border-style: solid;
                border-width: 2px;
              ">
            <span style="font-size: 25px">网络流量</span>
            <button type="button" style="
                  background-color: #00c2fd;
                  font-size: 20px;
                  margin-left: 150px;
                ">
              <a href="domain.html">开始</a>
            </button>
          </div>
        </div>
      </div>




      <!--中间 -->
      <div class="visual_conTop">
        <div class="visual_conTop_box visual_conTop1">
          <div>
            <h3>省际域数量统计</h3>
            <p id="mainTop1">0</p>
            <div class="conTop_smil">
              <a class="xd">个</a>
            </div>
          </div>
        </div>
        <div class="visual_conTop_box visual_conTop2">
          <div>
            <h3>城际域数量统计</h3>
            <p id="mainTop3">0</p>
            <div class="conTop_smil">
              <a class="xd">个</a>
            </div>
          </div>
        </div>
        <div class="clear"></div>
      </div>
      <div class="visual_conTop">
        <div class="visual_conTop_box visual_conTop1">
          <div>
            <h3>TCP占比</h3>
            <p id="mainTop2">0</p>
            <div class="conTop_smil">
              <a class="xd">%</a>
            </div>
          </div>
        </div>
        <div class="visual_conTop_box visual_conTop2">
          <div>
            <h3>UDP占比</h3>
            <p id="mainTop4">0</p>
            <div class="conTop_smil">
              <a class="xd">%</a>
            </div>
          </div>
        </div>
        <div class="clear"></div>
      </div>




      <!-- 网络流动 -->
      <div class="visual_conBot" style="height: 49%; margin-top: 2%">
        <div class="visual_chart_text">
          <h1>省域流速统计</h1>
        </div>
        <div class="visual_chart" id="main_domain_Bottom"></div>
      </div>
    </div>
    <script>
      option = {
        tooltip: {
          trigger: "axis",
          axisPointer: { lineStyle: { color: "#fff" } },
        },
        legend: {
          icon: "rect",
          itemWidth: 14,
          itemHeight: 5,
          itemGap: 10,
          data: ["江苏省", "山东省", "河南省"],
          right: "10px",
          top: "0px",
          textStyle: { fontSize: 12, color: "#fff" },
        },
        grid: { x: 45, y: 35, x2: 30, y2: 90 },
        xAxis: [
          {
            type: "category",
            boundaryGap: false,
            axisLine: { lineStyle: { color: "#57617B" } },
            axisLabel: { textStyle: { color: "#fff" } },
            data: 0,
          },
        ],
        yAxis: [
          {
            type: "value",
            axisTick: {
              show: false,
            },
            axisLine: { lineStyle: { color: "#57617B" } },
            axisLabel: {
              margin: 10,
              textStyle: { fontSize: 12 },
              textStyle: { color: "#fff" },
              formatter: "{value}MB",
            },
            splitLine: { lineStyle: { color: "#57617B" } },
          },
          {
            type: "value",
            axisTick: {
              show: false,
            },
            axisLine: { lineStyle: { color: "#57617B" } },
            axisLabel: {
              margin: 10,
              textStyle: { fontSize: 12 },
              textStyle: { color: "rgba(0,0,0,0)" },
              formatter: "{value}MB",
            },
            splitLine: { lineStyle: { color: "#57617B" } },
          },
        ],
        series: [
          {
            name: "江苏省",
            type: "line",
            smooth: true,
            lineStyle: { normal: { width: 2 } },
            yAxisIndex: 0,
            areaStyle: {
              normal: {
                color: new echarts.graphic.LinearGradient(
                  0,
                  0,
                  0,
                  1,
                  [
                    {
                      offset: 0,
                      color: "rgba(196, 13, 68, 0.3)",  // 从红色开始
                    },
                    {
                      offset: 0.8,
                      color: "rgba(185,150,248,0)",
                    },
                  ],
                  false
                ),
                shadowColor: "rgba(0, 0, 0, 0.1)",
                shadowBlur: 10,
              },
            },
            itemStyle: { normal: { color: "#c40d44" } },
            data: 0,
          },
          {
            name: "山东省",
            type: "line",
            smooth: true,
            lineStyle: { normal: { width: 2 } },
            yAxisIndex: 1,
            areaStyle: {
              normal: {
                color: new echarts.graphic.LinearGradient(
                  0,
                  0,
                  0,
                  1,
                  [
                    {
                      offset: 0,
                      color: "rgba(3, 194, 236, 0.3)",
                    },
                    {
                      offset: 0.8,
                      color: "rgba(3, 194, 236, 0)",
                    },
                  ],
                  false
                ),
                shadowColor: "rgba(0, 0, 0, 0.1)",
                shadowBlur: 10,
              },
            },
            itemStyle: { normal: { color: "#03C2EC" } },
            data: 0,
          },
          {
            name: "河南省",
            type: "line",
            smooth: true,
            lineStyle: { normal: { width: 2 } },
            yAxisIndex: 1,
            areaStyle: {
              normal: {
                color: new echarts.graphic.LinearGradient(
                  0,
                  0,
                  0,
                  1,
                  [
                    {
                      offset: 0,
                      color: "rgba(218, 57, 20, 0.3)",
                    },
                    {
                      offset: 0.8,
                      color: "rgba(218, 57, 20, 0)",
                    },
                  ],
                  false
                ),
                shadowColor: "rgba(0, 0, 0, 0.1)",
                shadowBlur: 10,
              },
            },
            itemStyle: { normal: { color: "#DA3914" } },
            data: 0,
          },
        ],
      };
      var myChart = echarts.init(document.getElementById("main_domain_Bottom"));
      myChart.setOption(option);
      window.addEventListener("resize", function () {
        myChart.resize();
      });
    </script>


