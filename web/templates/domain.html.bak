  <!-- 轮播swiper文件 -->
  <link rel="stylesheet" type="text/css" href="../static/domain/css/swiper.min.css" />
  <script src="../static/domain/js/swiper.min.js"></script>
  <!--界面样式-->
  <script src="../static/domain/js/domain.js?v=2016rr3650"></script>
  <script src="../static/domain/js/china.js"></script>
  <script src="../static/domain/js/chartMap.js"></script>
  <link rel="stylesheet" type="text/css" href="../static/domain/css/visual.css?v=2016s1020" />
  <link rel="stylesheet" type="text/css" href="../static/domain/css/index.css?v=112" />
