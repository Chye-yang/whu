        <script>
            option = {
                tooltip: {
                    trigger: "axis",
                    axisPointer: { lineStyle: { color: "#fff" } },
                },
                legend: {
                    icon: "rect",
                    itemWidth: 14,
                    itemHeight: 5,
                    itemGap: 10,
                    data: ["总流量", "上行流量", "下行流量"],
                    right: "10px",
                    top: "0px",
                    textStyle: { fontSize: 12, color: "#fff" },
                },
                grid: { x: 45, y: 35, x2: 30, y2: 90 },
                xAxis: [
                    {
                        type: "category",
                        boundaryGap: false,
                        axisLine: { lineStyle: { color: "#57617B" } },
                        axisLabel: { textStyle: { color: "#fff" } },
                        data: 0,
                    },
                ],
                yAxis: [
                    {
                        type: "value",
                        axisTick: {
                            show: false,
                        },
                        axisLine: { lineStyle: { color: "#57617B" } },
                        axisLabel: {
                            margin: 10,
                            textStyle: { fontSize: 12 },
                            textStyle: { color: "#fff" },
                            formatter: "{value}MB",
                        },
                        splitLine: { lineStyle: { color: "#57617B" } },
                    },
                    {
                        type: "value",
