                    <div class="visual_box">
                        <div class="t_line_box"></div>
                        <div class="main_title" style="left: 47%;">域统计</div>
                        <div class="main_table t_btn8" id="domain_table_container"
                            style="height: calc(100% - 50px); margin-top: 40px; overflow: hidden;">
                            <table>
                                <thead>
                                    <tr>
                                        <th style="width: 33%">域名</th>
                                        <th style="width: 33%">请求次数</th>
                                        <th style="width: 34%">域总数</th>
                                    </tr>
                                </thead>
                                <tbody id="table_domain">
                                    <tr>
                                        <td colspan="3">正在加载数据...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="t_line_box"></div>
                    </div>

                    <script>
                        // --- 配置 ---
                        // const csvFilePath = ''; // <--- !!! 修改为您 CSV 文件的实际路径 !!!
                        const csvFilePath = '/static/data/domin.csv';
                        const scrollSpeed = 1; // 滚动速度 (像素)
                        const scrollInterval = 50; // 滚动间隔 (毫秒, 值越小越快)
                        // --- 配置结束 ---

                        const tableBody = document.getElementById('table_domain');
                        const tableContainer = document.getElementById('domain_table_container');

                        let scrollIntervalId = null; // 用于存储 setInterval 的 ID

                        async function loadAndDisplayData() {
                            try {
                                const response = await fetch(csvFilePath);
                                if (!response.ok) {
                                    throw new Error(`无法加载 CSV 文件: ${response.statusText}`);
                                }
                                const csvText = await response.text();
                                const rows = csvText.trim().split('\n').filter(row => row.length > 0).map(row => row.split(','));

                                if (rows.length === 0) {
                                    tableBody.innerHTML = '<tr><td colspan="3">CSV 文件为空或格式错误</td></tr>';
                                    return;
                                }

                                const totalDomains = rows.length;
                                tableBody.innerHTML = ''; // 清空现有内容

                                rows.forEach(row => {
                                    const domain = row[0] || 'N/A';
                                    const count = row[1] || 'N/A';
                                    const tr = document.createElement('tr');
                                    tr.innerHTML = `
                        <td>${domain}</td>
                        <td>${count}</td>
                        <td>${totalDomains}</td>
                    `;
                                    tableBody.appendChild(tr);
                                });

                                // 启动滚动 (在数据加载后)
                                startScrolling();

                            } catch (error) {
                                console.error("加载或解析 CSV 时出错:", error);
                                tableBody.innerHTML = `<tr><td colspan="3">加载数据失败: ${error.message}</td></tr>`;
                            }
                        }

                        function startScrolling() {
                            // 先停止任何已有的滚动
                            if (scrollIntervalId) {
                                clearInterval(scrollIntervalId);
                            }

                            // 确保容器可以滚动 (如果需要)
                            tableContainer.style.overflow = 'hidden'; // 再次确认隐藏

                            const table = tableBody.parentNode; // 获取整个 table 元素

                            // 检查内容是否真的超出了容器
                            if (table.offsetHeight > tableContainer.clientHeight) {

                                // 复制内容以实现无缝滚动
                                tableBody.innerHTML += tableBody.innerHTML;

                                let currentScrollTop = 0;

                                scrollIntervalId = setInterval(() => {
                                    currentScrollTop += scrollSpeed;

                                    // 如果滚动超过了原始内容的高度，则重置回顶部
                                    // 注意：这里是 table.offsetHeight / 2 因为我们复制了内容
                                    if (currentScrollTop >= table.offsetHeight / 2) {
                                        currentScrollTop = 0;
                                    }

                                    // 设置容器的 scrollTop 来实现滚动
                                    tableContainer.scrollTop = currentScrollTop;

                                }, scrollInterval);

                                // (可选) 鼠标悬停时暂停滚动
                                tableContainer.addEventListener('mouseenter', () => clearInterval(scrollIntervalId));
                                tableContainer.addEventListener('mouseleave', () => startScrolling()); // 重新启动滚动需要调整逻辑，这里简单处理

                            } else {
                                console.log("内容未超出容器，无需滚动。");
                            }
                        }

                        // 页面加载完成后执行
                        window.addEventListener('load', loadAndDisplayData);

                    </script>


                </div>
            </div>
            <div class="visual_conBot" style="height: 38%; margin-top: 2%">
                <div class="visual_chart_text">
                    <h1>实时流量流动</h1>
